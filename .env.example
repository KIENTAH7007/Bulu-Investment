# Copy this file to backend/.env for local dev, or set these in Railway's
# Variables tab for deployment. Never commit the real .env file.

# Where the Railway Volume is mounted (set this to the volume's mount path in Railway)
DATA_DIR=/data

# Telegram bot (from @BotFather) and your personal chat id (from a "get my chat id" bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed once AI advisor / safety-read features are added (not required for Phase 2 core)
ANTHROPIC_API_KEY=
